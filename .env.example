# Neo4j 连接配置
GRAPHIFY_NEO4J_URI=bolt://localhost:7687
GRAPHIFY_NEO4J_USER=neo4j
GRAPHIFY_NEO4J_PASSWORD=password

# LLM 配置（格式：provider:model）
GRAPHIFY_LLM_MODEL=anthropic:claude-sonnet-4-6

# 去重配置
GRAPHIFY_DEDUP_SIMHASH_THRESHOLD=3
GRAPHIFY_DEDUP_SEMANTIC_THRESHOLD=0.95
GRAPHIFY_ENABLE_SEMANTIC_DEDUP=false

# Anthropic API Key（供 langchain-anthropic 使用）
ANTHROPIC_API_KEY=sk-ant-xxx

# LLM 配置：使用通义千问 qwen-plus（DashScope）
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=sk-ant-yyy